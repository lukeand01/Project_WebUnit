# Create a GitHub OAuth App and set its callback URL to:
#   http://localhost:3000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Must match the registered OAuth callback URL exactly.
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# A long random string used to sign browser session cookies.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Path to the Unity Editor executable on the backend machine.
# Example Windows: C:\Program Files\Unity\Hub\Editor\2022.3.62f1\Editor\Unity.exe
# Example macOS: /Applications/Unity/Hub/Editor/2022.3.62f1/Unity.app/Contents/MacOS/Unity
UNITY_EDITOR_PATH=

PORT=3000
# Set true only behind HTTPS.
COOKIE_SECURE=false
